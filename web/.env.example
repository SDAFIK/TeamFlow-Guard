TEAMFLOW_BACKEND=supabase
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=replace_with_publishable_key
APP_BASE_URL=http://localhost:3000
# Server only. Never prefix the Gemini key with NEXT_PUBLIC_.
GEMINI_API_KEY=
GEMINI_MODEL=
# Optional comma-separated exact origins for additional deployment aliases.
APP_ALLOWED_ORIGINS=

# Optional transactional invitation delivery (server-only; never NEXT_PUBLIC_).
# Configure only on an authorized verified sending domain. No provider calls when unset.
RESEND_API_KEY=
TEAMFLOW_INVITE_EMAIL_FROM=

# Optional GitHub App (server only). Bind one authorized repository to one workspace.
GITHUB_APP_ID=
GITHUB_APP_PRIVATE_KEY=
GITHUB_APP_WEBHOOK_SECRET=
TEAMFLOW_GITHUB_APP_BINDINGS=[]

# Stage 7: server-only privileged ingestion credential. Never expose to browser or logs.
TEAMFLOW_GITHUB_INGEST_KEY=
# JSON array: workspace_id, workflow_id, task_id. Explicitly authorize each mapping.
TEAMFLOW_GITHUB_CI_MAPPINGS=[]
