TEAMFLOW_BACKEND=supabase
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=replace_with_publishable_key
APP_BASE_URL=http://localhost:3000
# Server only. Never prefix the Gemini key with NEXT_PUBLIC_.
GEMINI_API_KEY=
GEMINI_MODEL=
# Optional comma-separated exact origins for additional deployment aliases.
APP_ALLOWED_ORIGINS=

# Optional transactional invitation delivery (server-only; never NEXT_PUBLIC_).
# Configure only on an authorized verified sending domain. No provider calls when unset.
RESEND_API_KEY=
TEAMFLOW_INVITE_EMAIL_FROM=
