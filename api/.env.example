# Local database credentials are generated by npm run db. Never commit api/.env.
DATABASE_URL=postgresql+psycopg://teamflow_app:REPLACE@127.0.0.1:55432/teamflow
MIGRATION_DATABASE_URL=postgresql+psycopg://teamflow_admin:REPLACE@127.0.0.1:55432/teamflow
TEST_DATABASE_URL=postgresql+psycopg://teamflow_admin:REPLACE@127.0.0.1:55432/teamflow_test
DEMO_PASSWORD=REPLACE_WITH_LOCAL_RANDOM_PASSWORD
WEB_ORIGIN=http://localhost:3000
OPENAI_API_KEY=
OPENAI_MODEL=
# Exact workflow name -> existing task key. No automatic mapping from source text.
GITHUB_REPOSITORY=
GITHUB_PROJECT_ID=
GITHUB_WORKFLOW_TASKS={}
# Only needed when a reachable HTTPS webhook endpoint is deployed.
GITHUB_WEBHOOK_SECRET=
