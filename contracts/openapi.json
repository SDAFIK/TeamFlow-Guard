  "components": {
    "schemas": {
      "Action": {
        "properties": {
          "task_id": {
            "type": "string",
            "format": "uuid",
            "title": "Task Id"
          },
          "field": {
            "type": "string",
            "enum": [
              "reviewer_id",
              "priority",
              "position",
              "dependency",
              "owner_id",
              "due_at"
            ],
            "title": "Field"
          },
          "before": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "integer"
              },
              {
                "type": "null"
              }
            ],
            "title": "Before"
          },
          "after": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "integer"
              }
            ],
            "title": "After"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "task_id",
          "field",
          "before",
          "after"
        ],
        "title": "Action"
      },
      "AuditView": {
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid",
            "title": "Id"
          },
          "actor_name": {
            "type": "string",
            "title": "Actor Name"
          },
          "kind": {
            "type": "string",
            "title": "Kind"
          },
          "summary": {
            "type": "string",
            "title": "Summary"
          },
          "plan_version": {
            "type": "integer",
            "title": "Plan Version"
          },
          "changes": {
            "items": {
              "additionalProperties": true,
              "type": "object"
            },
            "type": "array",
            "title": "Changes"
          },
          "created_at": {
            "type": "string",
            "format": "date-time",
            "title": "Created At"
          }
        },
        "type": "object",
        "required": [
          "id",
          "actor_name",
          "kind",
          "summary",
          "plan_version",
          "changes",
          "created_at"
        ],
        "title": "AuditView"
      },
      "AvailabilityInput": {
        "properties": {
          "hours": {
            "type": "integer",
            "maximum": 80.0,
            "minimum": 0.0,
            "title": "Hours"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "hours"
        ],
        "title": "AvailabilityInput"
      },
      "DecisionInput": {
        "properties": {
          "decision": {
            "type": "string",
            "enum": [
              "approve",
              "reject"
            ],
            "title": "Decision"
          },
          "base_plan_version": {
            "type": "integer",
            "minimum": 1.0,
            "title": "Base Plan Version"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "decision",
          "base_plan_version"
        ],
        "title": "DecisionInput"
      },
      "DecisionResult": {
        "properties": {
          "proposal_id": {
            "type": "string",
            "format": "uuid",
            "title": "Proposal Id"
          },
          "status": {
            "type": "string",
            "title": "Status"
          },
          "plan_version": {
            "type": "integer",
            "title": "Plan Version"
          },
          "audit_id": {
            "type": "string",
            "format": "uuid",
            "title": "Audit Id"
          }
        },
        "type": "object",
        "required": [
          "proposal_id",
          "status",
          "plan_version",
          "audit_id"
        ],
        "title": "DecisionResult"
      },
      "DemoEventInput": {
        "properties": {
          "kind": {
            "type": "string",
            "enum": [
              "ci_failure",
              "ci_pass",
              "review_delay",
              "capacity"
            ],
            "title": "Kind"
          },
          "task_id": {
            "type": "string",
            "format": "uuid",
            "title": "Task Id"
          },
          "event_key": {
            "type": "string",
            "maxLength": 100,
            "minLength": 8,
            "title": "Event Key"
          }
        },
        "additionalProperties": false,
